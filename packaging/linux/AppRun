#!/bin/sh
# The AppImage runtime sets APPDIR. Run from an extracted folder, it is the folder of this script.
HERE=${APPDIR:-$(dirname "$(readlink -f "$0")")}

export LIBHEIF_PLUGIN_PATH="$HERE/usr/lib/libheif/plugins"
# libvips looks for its modules in $VIPSHOME/x86_64-linux-gnu instead of the path it was built for.
export VIPSHOME="$HERE/usr/lib"

# Host GPU drivers load into the process later and may need a newer libstdc++ than the bundled one.
# So the host copy wins whenever it has every version the bundle needs.
needed=$(cat "$HERE/usr/lib/compat/needed")
host=$( (ldconfig -p || /sbin/ldconfig -p) 2>/dev/null | grep -F 'libstdc++.so.6 (libc6,x86-64)' | head -n 1 | sed 's/.*=> //')

if [ -z "$host" ] || ! grep -qaF "$needed" "$host"; then
    export LD_LIBRARY_PATH="$HERE/usr/lib/compat${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

exec "$HERE/usr/bin/tinyiv" "$@"
