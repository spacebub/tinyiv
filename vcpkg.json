{
  "name": "tinyiv",
  "version": "1.0.0",
  "description": "A tiny, fast image viewer",
  "license": "GPL-3.0-or-later",
  "builtin-baseline": "3037cbe976a6872e56e8b07152e19a8344360491",
  "dependencies": [
    {
      "$comment": "Linked for decoding grid tiles. Its default x265 encoder is turned off here, which vcpkg keeps unless the top level manifest says otherwise.",
      "name": "libheif",
      "default-features": false
    },
    "libjpeg-turbo",
    "libjxl",
    "libpng",
    {
      "name": "libvips",
      "features": [
        "analyze",
        "cplusplus",
        "exif",
        "heif",
        "highway",
        "jpeg",
        "jpeg-xl",
        "lcms",
        "nsgif",
        "openexr",
        "openjpeg",
        "png",
        "poppler",
        "ppm",
        "radiance",
        "rsvg",
        "tiff",
        "webp",
        "zlib"
      ]
    },
    "libwebp",
    {
      "name": "pkgconf",
      "host": true
    },
    "tiff",
    "zlib",
    "zstd"
  ]
}
